+				target = corenet.UDPDestination(corenet.LocalHostIP, 53)
+			}
+			config = strings.Replace(config, `"tag":"proxy"`, `"tag":"proxy","mux":{"enabled":true,"concurrency":8,"xudpConcurrency":8}`, 1)
+			inst, route := startHotRouteConfig(t, config)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			flow, err := core.Dial(ctx, inst, target)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer flow.Close()
+			if got := hotRouteExchange(t, flow, "before"); !strings.HasPrefix(got, "peer/") || !strings.HasSuffix(got, ":before") {
+				t.Fatal(got)
+			}
+			if err := route.Close(); err != nil {
+				t.Fatal(err)
+			}
+			finished := make(chan error, 1)
+			go func() { buffer := make([]byte, 2048); _, err := flow.Read(buffer); finished <- err }()
+			select {
+			case err := <-finished:
+				if err == nil {
+					t.Fatal("flow still readable after STOP")
+				}
+			case <-time.After(time.Second):
