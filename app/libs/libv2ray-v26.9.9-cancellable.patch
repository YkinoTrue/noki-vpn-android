+func hotRouteUDPPeer(t *testing.T, name string) string {
+	t.Helper()
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	go func() {
+		buffer := make([]byte, 2048)
+		for {
+			n, from, err := conn.ReadFrom(buffer)
+			if err != nil {
+				return
+			}
+			conn.WriteTo([]byte(fmt.Sprintf("%s/%s:%s", name, from.String(), buffer[:n])), from)
+		}
+	}()
+	return conn.LocalAddr().String()
+}
