+func TestHotRoutePrototypeRepeatedDrainKeepsHandlerCountBounded(t *testing.T) {
+	inst, route := startHotRoutePrototype(t)
+	old := hotRouteDial(t, inst, "")
+	hotRouteExchange(t, old, "initial")
+	base := uint64(0)
+	for i := 0; i < 20; i++ {
+		name := fmt.Sprintf("peer-%d", i)
+		id, err := route.prepare(base, hotRouteConfig("ignored", hotRoutePeer(t, name)))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := route.probe(id, func(tag string) error {
+			conn := hotRouteDial(t, inst, tag)
+			defer conn.Close()
+			if got := hotRouteExchange(t, conn, "finish"); got != name+"/1:finish" {
+				return fmt.Errorf("wrong path %s", got)
+			}
+			return nil
+		}); err != nil {
+			t.Fatal(err)
+		}
+		if err := route.commit(base, id); err != nil {
+			t.Fatal(err)
+		}
+		if len(route.manager.ListHandlers(context.Background())) > 3 {
+			t.Fatal("handler budget exceeded")
+		}
+		cancelled, cancel := context.WithCancel(context.Background())
+		cancel()
+		if route.waitDrain(cancelled) == nil {
+			t.Fatal("drain completed while old TCP still live")
+		}
+		// core.Dial.Close does not immediately finish the remote half of TCP.
+		// Let the peer close too; drain must follow actual Dispatch completion.
+		hotRouteExchange(t, old, "finish")
+		old.Close()
+		ctx, finish := context.WithTimeout(context.Background(), time.Second)
+		err = route.waitDrain(ctx)
+		finish()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(route.manager.ListHandlers(context.Background())) != 2 {
+			t.Fatal("drained handler retained")
+		}
+		old = hotRouteDial(t, inst, "")
+		if got := hotRouteExchange(t, old, "new"); got != name+"/2:new" {
+			t.Fatal(got)
+		}
+		base = id
+	}
+}
