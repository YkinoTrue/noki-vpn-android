+func TestHotRoutePrototypeUDPAssociationStaysOnOldGeneration(t *testing.T) {
+	for _, transport := range []string{"freedom", "vless-tls", "vless-tls-xudp"} {
+		t.Run(transport, func(t *testing.T) {
+			config := func(peer string) string {
+				if strings.HasPrefix(transport, "vless-tls") {
+					config := hotRouteVlessTLS(t, peer)
+					if transport == "vless-tls-xudp" {
+						config = strings.Replace(config, `"tag":"proxy"`, `"tag":"proxy","mux":{"enabled":true,"concurrency":-1,"xudpConcurrency":8}`, 1)
+					}
+					return config
+				}
+				return hotRouteConfig("proxy", peer)
+			}
+			inst, route := startHotRouteConfig(t, config(hotRouteUDPPeer(t, "old")))
+			dial := func(tag string) (net.Conn, context.CancelFunc) {
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				t.Cleanup(cancel)
+				if tag != "" {
+					ctx = session.SetForcedOutboundTagToContext(ctx, tag)
+				}
+				conn, err := core.Dial(ctx, inst, corenet.UDPDestination(corenet.LocalHostIP, 53))
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { conn.Close() })
+				return conn, cancel
+			}
+			exchange := func(conn net.Conn, message string) string {
+				t.Helper()
+				if _, err := conn.Write([]byte(message)); err != nil {
+					t.Fatal(err)
+				}
+				buffer := make([]byte, 2048)
+				n, err := conn.Read(buffer)
+				if err != nil {
+					t.Fatal(err)
+				}
+				return string(buffer[:n])
+			}
+			old, cancelOld := dial("")
+			first := exchange(old, "1")
+			if !strings.HasPrefix(first, "old/") || !strings.HasSuffix(first, ":1") {
+				t.Fatal(first)
+			}
+			identity := strings.TrimSuffix(first, ":1")
+			id, err := route.prepare(0, config(hotRouteUDPPeer(t, "candidate")))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := route.probe(id, func(tag string) error {
+				probe, cancel := dial(tag)
+				defer cancel()
+				defer probe.Close()
+				got := exchange(probe, "probe")
+				if !strings.HasPrefix(got, "candidate/") || !strings.HasSuffix(got, ":probe") {
+					return fmt.Errorf("wrong UDP probe: %s", got)
+				}
+				return nil
+			}); err != nil {
+				t.Fatal(err)
+			}
+			if err := route.commit(0, id); err != nil {
+				t.Fatal(err)
+			}
+			for i := 2; i <= 20; i++ {
+				message := fmt.Sprint(i)
+				if got := exchange(old, message); got != identity+":"+message {
+					t.Fatal("UDP association or sequence changed: ", got)
+				}
+			}
+			next, cancelNext := dial("")
+			defer cancelNext()
+			if got := exchange(next, "new"); !strings.HasPrefix(got, "candidate/") || !strings.HasSuffix(got, ":new") {
+				t.Fatal(got)
+			}
+			cancelled, cancel := context.WithCancel(context.Background())
+			cancel()
+			if route.waitDrain(cancelled) == nil {
+				t.Fatal("live UDP association not retained")
+			}
+			cancelOld()
+			old.Close()
+			ctx, finish := context.WithTimeout(context.Background(), time.Second)
+			defer finish()
+			if err := route.waitDrain(ctx); err != nil {
+				t.Fatal(err)
+			}
+			if len(route.manager.ListHandlers(context.Background())) != 2 {
+				t.Fatal("old UDP generation retained")
+			}
+		})
+	}
+}
