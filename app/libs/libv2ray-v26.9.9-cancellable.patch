+func TestHotRouteNativeReadinessUsesCandidateAndBudget(t *testing.T) {
+	for _, transport := range []string{"freedom", "vless-tls-mux"} {
+		t.Run(transport, func(t *testing.T) {
+			config := func(peer string) string {
+				if transport == "freedom" {
+					return hotRouteConfig("proxy", peer)
+				}
+				return strings.Replace(hotRouteVlessTLS(t, peer), `"tag":"proxy"`, `"tag":"proxy","mux":{"enabled":true,"concurrency":8}`, 1)
+			}
+
+			var oldRequests, candidateRequests atomic.Int32
+			oldServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				oldRequests.Add(1)
+				w.WriteHeader(http.StatusServiceUnavailable)
+			}))
+			defer oldServer.Close()
+			candidateServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				candidateRequests.Add(1)
+				if r.URL.Path == "/large" {
+					fmt.Fprint(w, strings.Repeat("x", 128))
+					return
+				}
+				w.WriteHeader(http.StatusNoContent)
+			}))
+			defer candidateServer.Close()
+			_, route := startHotRouteConfig(t, config(strings.TrimPrefix(oldServer.URL, "http://")))
+			id, err := route.prepare(0, config(strings.TrimPrefix(candidateServer.URL, "http://")))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := route.probeURL(id, "http://candidate.invalid/large", 1000, 32); err == nil {
+				t.Fatal("oversized readiness accepted")
+			}
+			if route.commit(0, id) == nil {
+				t.Fatal("oversized probe published")
+			}
+			if delay, err := route.probeURL(id, "http://candidate.invalid/health", 1000, 32); err != nil || delay < 1 {
+				t.Fatal("candidate probe failed: ", delay, err)
+			}
+			if oldRequests.Load() != 0 || candidateRequests.Load() == 0 {
+				t.Fatal("readiness used wrong outbound")
+			}
+			// A failed recheck must revoke prior readiness too.
+			if _, err := route.probeURL(id, "http://candidate.invalid/health", 0, 32); err == nil {
+				t.Fatal("invalid timeout accepted")
+			}
+			if route.commit(0, id) == nil {
+				t.Fatal("invalid recheck retained readiness")
+			}
+			if _, err := route.probeURL(id, "http://candidate.invalid/health", 1000, 32); err != nil {
+				t.Fatal(err)
+			}
+			if err := route.commit(0, id); err != nil {
+				t.Fatal(err)
+			}
+
+		})
+	}
+}
