+                if err != nil { t.Fatal(err) }
+                controller := NewCoreController(&stopProbeCallbacks{})
+                defer controller.StopLoop()
+                if hot { err = controller.StartLoopWithHotRoute(string(data), 0, "proxy") } else { err = controller.StartLoop(string(data), 0) }
+                if err != nil { t.Fatal(err) }
+                if delay, err := controller.MeasureDelayWithTimeout("http://target.invalid/health", 1500); err != nil || delay < 1 {
+                    t.Fatalf("default readiness: delay=%d error=%v", delay, err)
+                }
+            })
+        }
+    }
+}
+
+func TestHotRouteInitialVisionReadinessWithMultipleOutbounds(t *testing.T) {
+    peer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+        w.WriteHeader(http.StatusNoContent)
+    }))
+    defer peer.Close()
+    for _, muxEnabled := range []bool{false, true} {
+        for _, hot := range []bool{false, true} {
+            t.Run(fmt.Sprintf("mux=%v/hot=%v", muxEnabled, hot), func(t *testing.T) {
+                var config map[string]interface{}
+                if err := json.Unmarshal([]byte(hotRouteVlessTLS(t, strings.TrimPrefix(peer.URL, "http://"), "xtls-rprx-vision")), &config); err != nil { t.Fatal(err) }
+                outbounds := config["outbounds"].([]interface{})
+                outbounds[0].(map[string]interface{})["mux"] = map[string]interface{}{"enabled": muxEnabled}
+                config["outbounds"] = append(outbounds,
+                    map[string]interface{}{"tag":"direct", "protocol":"freedom"},
+                    map[string]interface{}{"tag":"block", "protocol":"blackhole"})
+                config["stats"] = map[string]interface{}{}
+                data, err := json.Marshal(config)
+                if err != nil { t.Fatal(err) }
+                controller := NewCoreController(&stopProbeCallbacks{})
+                defer controller.StopLoop()
+                if hot { err = controller.StartLoopWithHotRoute(string(data), 0, "proxy") } else { err = controller.StartLoop(string(data), 0) }
+                if err != nil { t.Fatal(err) }
+                delay, err := controller.MeasureDelayWithTimeout("http://target.invalid/health", 1500)
+                if muxEnabled {
+                    // Both the unwrapped control and hot route reject Vision over mux.
+                    if err == nil { t.Fatal("Vision/mux unexpectedly accepted") }
+                } else if err != nil || delay < 1 {
+                    t.Fatalf("default readiness: delay=%d error=%v", delay, err)
+                }
+            })
+        }
+    }
+}
