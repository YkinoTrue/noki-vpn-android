+// A real local TCP peer reports its accept identity on every request. No client
+// retries or reconnects hide a lost flow; every peer has a bounded lifetime.
+func hotRoutePeer(t *testing.T, name string) string {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	var accepted atomic.Int32
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			id := accepted.Add(1)
+			go func() {
+				defer conn.Close()
+				conn.SetDeadline(time.Now().Add(10 * time.Second))
+				reader := bufio.NewReader(conn)
+				for {
+					line, err := reader.ReadString('\n')
+					if err != nil {
+						return
+					}
+					if _, err := fmt.Fprintf(conn, "%s/%d:%s", name, id, line); err != nil {
+						return
+					}
+					if strings.TrimSpace(line) == "finish" {
+						return
+					}
+				}
+			}()
+		}
+	}()
+	return listener.Addr().String()
+}
+
+func hotRouteConfig(tag, redirect string) string {
+	return fmt.Sprintf(`{"outbounds":[{"tag":%q,"protocol":"freedom","settings":{"redirect":%q}}],"routing":{"rules":[{"type":"field","network":"tcp","outboundTag":%q}]}}`, tag, redirect, tag)
+}
+
+func hotRouteRules(t *testing.T, config string) *serial.TypedMessage {
+	t.Helper()
+	parsed, err := coreserial.LoadJSONConfig(strings.NewReader(config))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, app := range parsed.App {
+		if app.Type == "xray.app.router.Config" {
+			return app
+		}
+	}
+	t.Fatal("routing config missing")
+	return nil
+}
+
+func hotRouteDial(t *testing.T, inst *core.Instance, forcedTag string) net.Conn {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	t.Cleanup(cancel)
+	if forcedTag != "" {
+		ctx = session.SetForcedOutboundTagToContext(ctx, forcedTag)
+	}
+	conn, err := core.Dial(ctx, inst, corenet.TCPDestination(corenet.LocalHostIP, 9))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	return conn
+}
+
+func hotRouteExchange(t *testing.T, conn net.Conn, message string) string {
+	t.Helper()
+	if _, err := fmt.Fprintln(conn, message); err != nil {
+		t.Fatal(err)
+	}
+	line, err := bufio.NewReader(conn).ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	return strings.TrimSpace(line)
+}
