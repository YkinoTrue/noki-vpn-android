+type stopProbeCallbacks struct{ starts, stops int }
+
+func (c *stopProbeCallbacks) Startup() int               { c.starts++; return 0 }
+func (c *stopProbeCallbacks) Shutdown() int              { c.stops++; return 0 }
+func (*stopProbeCallbacks) OnEmitStatus(int, string) int { return 0 }
+
+func TestStopCancelsMeasurementBeforeClosingCoreAndNotifiesOnce(t *testing.T) {
+	callbacks := &stopProbeCallbacks{}
+	controller := NewCoreController(callbacks)
+	if err := controller.StartLoop(`{"stats":{},"outbounds":[{"tag":"proxy","protocol":"freedom"}]}`, 0); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { controller.StopLoop() })
+	ctx, finish := controller.beginDelayMeasurement(time.Second)
+	released := make(chan struct{})
+	go func() { <-ctx.Done(); finish(); close(released) }()
+	if err := controller.StopLoop(); err != nil {
+		t.Fatal(err)
+	}
+	<-released
