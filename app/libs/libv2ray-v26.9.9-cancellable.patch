+
+func TestDelayMeasurementHonorsTimeout(t *testing.T) {
+	controller := &CoreController{}
+	ctx, finish := controller.beginDelayMeasurement(10 * time.Millisecond)
+	defer finish()
+
+	<-ctx.Done()
+
+	if !errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		t.Fatalf("expected deadline exceeded, got %v", ctx.Err())
+	}
+}
+
+func TestCancelMeasureDelayCancelsActiveMeasurement(t *testing.T) {
+	controller := &CoreController{}
+	ctx, finish := controller.beginDelayMeasurement(time.Second)
+	defer finish()
+
+	controller.CancelMeasureDelay()
+	<-ctx.Done()
+
+	if !errors.Is(ctx.Err(), context.Canceled) {
+		t.Fatalf("expected canceled, got %v", ctx.Err())
+	}
+}
+
+func TestOldCompletionDoesNotClearNewMeasurement(t *testing.T) {
+	controller := &CoreController{}
+	oldCtx, finishOld := controller.beginDelayMeasurement(time.Second)
+	newCtx, finishNew := controller.beginDelayMeasurement(time.Second)
+	defer finishNew()
+
+	<-oldCtx.Done()
+	finishOld()
+	controller.CancelMeasureDelay()
+	<-newCtx.Done()
+
+	if !errors.Is(newCtx.Err(), context.Canceled) {
+		t.Fatalf("expected new measurement to remain cancellable, got %v", newCtx.Err())
+	}
+}
+
+// TLS is real and the HTTP client's DialContext routes through the pinned Xray
+// instance. Only the local test CA is injected at the TLS trust boundary.
+func testProbeClient(t *testing.T, handler http.HandlerFunc) (*http.Client, string) {
+	t.Helper()
+	server := httptest.NewTLSServer(handler)
+	t.Cleanup(server.Close)
+	inst, err := core.StartInstance("json", []byte(`{"outbounds":[{"protocol":"freedom","tag":"proxy"}]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { inst.Close() })
+	client := newProbeHTTPClient(inst)
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	client.Transport.(*http.Transport).TLSClientConfig = &tls.Config{RootCAs: roots, MinVersion: tls.VersionTLS12}
+	return client, server.URL
+}
+
+func TestProbeRejectsTLSBodyStalledAfter16KiB(t *testing.T) {
+	client, url := testProbeClient(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "65536")
+		w.Write(bytes.Repeat([]byte("x"), 16*1024))
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	delay, err := measureHTTPDelay(ctx, client, url, 128*1024)
+	if delay >= 0 || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("stalled TLS body accepted: delay=%d error=%v", delay, err)
+	}
+}
+
+func TestProbeAcceptsCompleteTLSBodyWithinSharedBudget(t *testing.T) {
+	var requests atomic.Int32
+	client, url := testProbeClient(t, func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		w.Write(bytes.Repeat([]byte("x"), 64*1024))
+	})
+	delay, err := measureHTTPDelay(context.Background(), client, url, 128*1024)
+	if err != nil || delay <= 0 || requests.Load() != 2 {
+		t.Fatalf("complete response rejected: delay=%d requests=%d error=%v", delay, requests.Load(), err)
+	}
+}
+
+func TestProbeRejectsOversizedBody(t *testing.T) {
+	client, url := testProbeClient(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Write(bytes.Repeat([]byte("x"), 64*1024))
+	})
+	delay, err := measureHTTPDelay(context.Background(), client, url, 16*1024)
+	if delay >= 0 || err == nil {
+		t.Fatalf("oversized response accepted: delay=%d error=%v", delay, err)
+	}
+}
+
+func TestProbeCancellationAfterTLSHeadersIsNotSuccess(t *testing.T) {
+	headers := make(chan struct{}, 1)
+	client, url := testProbeClient(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "65536")
+		w.Write(bytes.Repeat([]byte("x"), 16*1024))
+		w.(http.Flusher).Flush()
+		headers <- struct{}{}
+		<-r.Context().Done()
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := measureHTTPDelay(ctx, client, url, 128*1024); done <- err }()
+	select {
+	case <-headers:
+	case <-time.After(5 * time.Second):
+		t.Fatal("no TLS response headers")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("expected cancellation: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("probe did not stop after cancellation")
+	}
+}
+
+func TestOutboundProbeCancelledBeforeMeasureCannotStart(t *testing.T) {
+	probe := NewOutboundProbe()
+	probe.Cancel()
+	_, err := probe.Measure("invalid config would otherwise fail parsing", "", 1000, 65536)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel before native entry lost: %v", err)
+	}
+}
+
+func TestOutboundProbeCancellationIsIsolatedAndSingleUse(t *testing.T) {
+	headers := make(chan struct{}, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/stall" {
+			w.Header().Set("Content-Length", "65536")
+			w.Write(bytes.Repeat([]byte("x"), 16*1024))
+			w.(http.Flusher).Flush()
+			headers <- struct{}{}
+			<-r.Context().Done()
+		} else {
+			w.Write(bytes.Repeat([]byte("x"), 32*1024))
+		}
+	}))
+	defer server.Close()
+	config := `{"outbounds":[{"protocol":"freedom","tag":"proxy"}]}`
+	cancelled := NewOutboundProbe()
+	healthy := NewOutboundProbe()
+	defer cancelled.Cancel()
+	done := make(chan error, 1)
+	go func() { _, err := cancelled.Measure(config, server.URL+"/stall", 5000, 128*1024); done <- err }()
+	select {
+	case <-headers:
+	case <-time.After(5 * time.Second):
+		t.Fatal("probe did not reach server")
+	}
+	cancelled.Cancel()
+	delay, err := healthy.Measure(config, server.URL+"/healthy", 5000, 128*1024)
+	if err != nil || delay <= 0 {
+		t.Fatalf("sibling cancelled or failed: delay=%d error=%v", delay, err)
+	}
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("expected native cancellation: %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("native cancellation did not release attempt")
+	}
+	if _, err := healthy.Measure(config, server.URL, 1000, 65536); err == nil {
+		t.Fatal("probe reused")
+	}
+}
