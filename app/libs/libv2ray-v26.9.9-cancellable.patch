+type hotGeneration struct {
+	outbound.Handler
+	owner             *hotRoute
+	id                uint64
+	users             int
+	mux               bool
+	registered, ready bool
+	lifetime          context.Context
+	cancel            context.CancelFunc
+	closeOnce         sync.Once
+	disposeOnce       sync.Once
+	disposed          chan struct{}
+}
+
+// Keep the native mux Dispatch synchronous without losing pipe interruption or
+// timeout support. Only client sessions pass here; their XUDP field is nil.
+type hotRouteMuxReader struct{ *pipe.Reader }
+
+func usesMux(handler outbound.Handler) (bool, error) {
+	value, err := handler.SenderSettings().GetInstance()
+	if err != nil {
+		return false, err
+	}
+	sender, ok := value.(*proxyman.SenderConfig)
+	if !ok {
+		return false, errors.New("hot route requires SenderConfig")
+	}
+	return sender.MultiplexSettings != nil && sender.MultiplexSettings.Enabled, nil
+}
+
+func newHotRoute(inst *core.Instance, tag string) (*hotRoute, error) {
+	manager := inst.GetFeature(outbound.ManagerType()).(outbound.Manager)
+	initial := manager.GetHandler(tag)
+	if initial == nil || manager.GetDefaultHandler() != initial {
+		return nil, errors.New("hot route must wrap the initial default handler")
+	}
+	mux, err := usesMux(initial)
+	if err != nil {
+		return nil, err
+	}
+	s := &hotRoute{Handler: initial, inst: inst, manager: manager, stopped: make(chan struct{})}
+	ctx, cancel := context.WithCancel(context.Background())
+	s.current = &hotGeneration{Handler: initial, owner: s, mux: mux, lifetime: ctx, cancel: cancel, disposed: make(chan struct{})}
+	if err := manager.RemoveHandler(context.Background(), tag); err != nil {
+		cancel()
+		return nil, err
+	}
+	if err := manager.AddHandler(context.Background(), s); err != nil {
+		manager.RemoveHandler(context.Background(), tag)
+		manager.AddHandler(context.Background(), initial)
+		cancel()
+		return nil, err
+	}
+	return s, nil
+}
+
+func (g *hotGeneration) Close() error {
+	var err error
+	g.closeOnce.Do(func() { g.cancel(); err = g.Handler.Close() })
+	return err
+}
+
+func (s *hotRoute) dispose(g *hotGeneration) {
+	if g == nil {
+		return
+	}
+	g.disposeOnce.Do(func() {
+		if g.registered {
+			s.manager.RemoveHandler(context.Background(), g.Tag())
+		}
+		g.Close()
+		s.mu.Lock()
+		if s.draining == g {
+			s.draining = nil
+		}
+		s.mu.Unlock()
+		close(g.disposed)
+	})
+}
+
+func (s *hotRoute) waitDrain(ctx context.Context) error {
+	s.mu.Lock()
+	g, closed := s.draining, s.closed
+	s.mu.Unlock()
+	if closed {
+		return errors.New("route closed")
+	}
+	if g == nil {
+		return nil
+	}
+	select {
+	case <-g.disposed:
+		return nil
+	case <-s.stopped:
+		return errors.New("route closed")
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (s *hotRoute) prepare(base uint64, config string) (uint64, error) {
+	s.operations.Lock()
+	defer s.operations.Unlock()
+	s.mu.Lock()
+	if s.closed || s.version != base || s.prepared != nil || s.draining != nil {
+		s.mu.Unlock()
+		return 0, errors.New("stale version, closed route or generation budget exhausted")
+	}
+	s.next++
+	id := s.next
+	s.mu.Unlock()
+	parsed, err := coreserial.LoadJSONConfig(strings.NewReader(config))
+	if err != nil {
+		return 0, err
+	}
+	if len(parsed.Outbound) != 1 {
+		return 0, errors.New("exactly one candidate outbound required")
+	}
+	tag := fmt.Sprintf("%s-candidate-%d", s.Tag(), id)
+	if s.manager.GetHandler(tag) != nil {
+		return 0, errors.New("candidate tag already exists")
+	}
+	parsed.Outbound[0].Tag = tag
+	object, err := core.CreateObject(s.inst, parsed.Outbound[0])
+	if err != nil {
+		return 0, err
+	}
+	handler := object.(outbound.Handler)
+	mux, err := usesMux(handler)
+	if err != nil {
+		handler.Close()
+		return 0, err
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	g := &hotGeneration{Handler: handler, owner: s, mux: mux, id: id, registered: true, lifetime: ctx, cancel: cancel, disposed: make(chan struct{})}
+	if err := s.manager.AddHandler(context.Background(), g); err != nil {
+		s.dispose(g)
+		return 0, err
+	}
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		s.dispose(g)
+		return 0, errors.New("route closed during preparation")
+	}
+	s.prepared = g
+	s.mu.Unlock()
+	return id, nil
+}
+
+// probeURL uses the existing bounded HTTP probe on this exact candidate.
+// Generation cancellation also cancels readiness when STOP wins.
+func (s *hotRoute) probeURL(id uint64, url string, timeoutMillis, responseBudget int64) (int64, error) {
+	delay := int64(-1)
+	err := s.probe(id, func(tag string) error {
+		if timeoutMillis <= 0 || timeoutMillis > 12000 {
+			return errors.New("probe timeout must be between 1 and 12000 milliseconds")
+		}
+		s.mu.Lock()
+		lifetime := s.prepared.lifetime
+		s.mu.Unlock()
+		ctx, cancel := context.WithTimeout(lifetime, time.Duration(timeoutMillis)*time.Millisecond)
+		defer cancel()
+		ctx = session.SetForcedOutboundTagToContext(ctx, tag)
+		var err error
+		delay, err = measureHTTPDelay(ctx, newProbeHTTPClient(s.inst), url, responseBudget)
+		return err
+	})
+	if err != nil {
+		return -1, err
+	}
+	return delay, nil
+}
+
+// Serializes candidate validation and publication. Custom checks are host-test
+// fixtures; the Android binding must expose only probeURL.
+func (s *hotRoute) probe(id uint64, check func(string) error) error {
+	s.operations.Lock()
+	defer s.operations.Unlock()
+	s.mu.Lock()
+	g := s.prepared
+	if s.closed || g == nil || g.id != id {
+		s.mu.Unlock()
+		return errors.New("stale candidate")
+	}
+	g.ready = false
+	s.mu.Unlock()
+	if err := check(g.Tag()); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || g.lifetime.Err() != nil {
+		return errors.New("route closed or candidate cancelled during probe")
+	}
+	g.ready = true
+	return nil
+}
+
+func (s *hotRoute) commit(base, id uint64) error {
+	s.operations.Lock()
+	defer s.operations.Unlock()
+	s.mu.Lock()
+	next := s.prepared
+	if s.closed || s.version != base || next == nil || next.id != id || !next.ready || next.lifetime.Err() != nil || s.draining != nil {
+		s.mu.Unlock()
+		return errors.New("stale, unverified or blocked candidate")
+	}
+	old := s.current
+	s.current, s.prepared = next, nil
+	s.version = id
+	if old.users > 0 {
+		s.draining = old
+		old = nil
+	}
+	s.mu.Unlock()
+	s.dispose(old)
+	return nil
+}
+
+// rollback can restore only a still-live previous generation. Once it has
+// drained, callers must prepare and validate its configuration again.
+// Publication gets a fresh version even though the handler itself is reused.
+func (s *hotRoute) rollback(base, previousID uint64) (uint64, error) {
+	s.operations.Lock()
+	defer s.operations.Unlock()
+	s.mu.Lock()
+	previous := s.draining
+	if s.closed || s.version != base || s.prepared != nil || previous == nil || previous.id != previousID || previous.users == 0 || previous.lifetime.Err() != nil {
+		s.mu.Unlock()
+		return 0, errors.New("stale rollback or previous generation no longer available")
+	}
+	failed := s.current
+	s.next++
+	s.version = s.next
+	version := s.version
+	s.current, s.draining = previous, nil
+	if failed.users > 0 {
+		s.draining = failed
+		failed = nil
+	}
+	s.mu.Unlock()
+	s.dispose(failed)
+	return version, nil
+}
+
+func (s *hotRoute) abort(id uint64) error {
+	// Cancel before waiting for the serialized probe, so abort is prompt.
+	s.mu.Lock()
+	if g := s.prepared; g != nil && g.id == id {
+		g.cancel()
+	}
+	s.mu.Unlock()
+	s.operations.Lock()
+	defer s.operations.Unlock()
+	s.mu.Lock()
+	g := s.prepared
+	if g == nil || g.id != id {
+		s.mu.Unlock()
+		return errors.New("stale candidate")
+	}
+	s.prepared = nil
+	s.mu.Unlock()
+	s.dispose(g)
+	return nil
+}
+
+func (s *hotRoute) Close() error {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return nil
+	}
+	s.closed = true
+	close(s.stopped)
+	generations := []*hotGeneration{s.current, s.prepared, s.draining}
+	s.mu.Unlock()
+	// Manager.Close holds its own lock: never call RemoveHandler here.
+	for _, g := range generations {
+		if g != nil {
+			g.Close()
+		}
+	}
+	return nil
+}
+
+func (s *hotRoute) Dispatch(ctx context.Context, link *transport.Link) { s.dispatch(nil, ctx, link) }
+func (g *hotGeneration) Dispatch(ctx context.Context, link *transport.Link) {
+	g.owner.dispatch(g, ctx, link)
+}
+
+func (s *hotRoute) dispatch(g *hotGeneration, ctx context.Context, link *transport.Link) {
+	s.mu.Lock()
+	if g == nil {
+		g = s.current
+	}
+	obs := session.OutboundsFromContext(ctx)
+	if s.closed || g.lifetime.Err() != nil || (g != s.current && g != s.prepared) || len(obs) == 0 || (obs[len(obs)-1].Target.Network != corenet.Network_TCP && obs[len(obs)-1].Target.Network != corenet.Network_UDP) {
+		s.mu.Unlock()
+		common.Interrupt(link.Reader)
+		common.Interrupt(link.Writer)
+		return
+	}
+	g.users++
+	s.mu.Unlock()
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(g.lifetime, cancel)
+	defer func() {
+		stop()
+		cancel()
+		s.mu.Lock()
+		g.users--
+		drained := s.draining == g && g.users == 0
+		s.mu.Unlock()
+		if drained {
+			s.dispose(g)
+		}
+	}()
+	if g.mux {
+		if reader, ok := link.Reader.(*pipe.Reader); ok {
+			link.Reader = &hotRouteMuxReader{reader}
+		}
+		reader, writer := link.Reader, link.Writer
+		stopIO := context.AfterFunc(ctx, func() { common.Interrupt(reader); common.Interrupt(writer) })
+		defer func() {
+			stopIO()
+			// Dispatch may return on ctx.Done before AfterFunc starts.
+			if ctx.Err() != nil {
+				common.Interrupt(reader)
+				common.Interrupt(writer)
+			}
+		}()
+	}
+	g.Handler.Dispatch(ctx, link)
+}
+
+// HotRouteRuntimeID identifies this controller's current opted-in core lifetime.
+func (x *CoreController) HotRouteRuntimeID() (int64, error) {
+	x.coreMutex.Lock()
+	defer x.coreMutex.Unlock()
+	if !x.IsRunning || x.hotRoute == nil {
+		return 0, errors.New("hot routing is not active")
+	}
+	return x.runtimeID, nil
+}
+
+func (x *CoreController) ownedHotRoute(runtimeID int64) (*hotRoute, error) {
+	x.coreMutex.Lock()
+	defer x.coreMutex.Unlock()
+	if runtimeID <= 0 || runtimeID != x.runtimeID || !x.IsRunning || x.hotRoute == nil {
+		return nil, errors.New("stale hot route runtime")
+	}
+	return x.hotRoute, nil
+}
+
+func (x *CoreController) HotRouteVersion(runtimeID int64) (int64, error) {
+	route, err := x.ownedHotRoute(runtimeID)
+	if err != nil {
+		return -1, err
+	}
+	route.mu.Lock()
+	defer route.mu.Unlock()
+	if route.closed {
+		return -1, errors.New("route closed")
+	}
+	return int64(route.version), nil
+}
+
+func (x *CoreController) PrepareHotRoute(runtimeID, base int64, config string) (int64, error) {
+	if base < 0 {
+		return -1, errors.New("negative route version")
+	}
+	route, err := x.ownedHotRoute(runtimeID)
+	if err != nil {
+		return -1, err
+	}
+	id, err := route.prepare(uint64(base), config)
+	if err != nil {
+		return -1, err
+	}
+	return int64(id), nil
+}
+
+func (x *CoreController) ProbeHotRoute(runtimeID, candidateID int64, url string, timeoutMillis, responseBudget int64) (int64, error) {
+	if candidateID <= 0 {
+		return -1, errors.New("invalid candidate ID")
+	}
+	route, err := x.ownedHotRoute(runtimeID)
+	if err != nil {
+		return -1, err
+	}
+	return route.probeURL(uint64(candidateID), url, timeoutMillis, responseBudget)
+}
+
+func (x *CoreController) CommitHotRoute(runtimeID, base, candidateID int64) error {
+	if base < 0 || candidateID <= 0 {
+		return errors.New("invalid route version or candidate ID")
+	}
+	route, err := x.ownedHotRoute(runtimeID)
+	if err != nil {
+		return err
+	}
+	return route.commit(uint64(base), uint64(candidateID))
+}
+
+func (x *CoreController) AbortHotRoute(runtimeID, candidateID int64) error {
+	if candidateID <= 0 {
+		return errors.New("invalid candidate ID")
+	}
+	route, err := x.ownedHotRoute(runtimeID)
+	if err != nil {
+		return err
+	}
+	return route.abort(uint64(candidateID))
+}
+
+func (x *CoreController) RollbackHotRoute(runtimeID, base, previousID int64) (int64, error) {
+	if base < 0 || previousID < 0 {
+		return -1, errors.New("invalid route version or previous ID")
+	}
+	route, err := x.ownedHotRoute(runtimeID)
+	if err != nil {
+		return -1, err
+	}
+	version, err := route.rollback(uint64(base), uint64(previousID))
+	if err != nil {
+		return -1, err
+	}
+	return int64(version), nil
+}
