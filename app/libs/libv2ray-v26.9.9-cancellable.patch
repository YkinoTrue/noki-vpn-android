+func TestHotRouteRollbackPreservesBothFlowsAndRejectsStaleVersion(t *testing.T) {
+	config := func(name string) string {
+		return strings.Replace(hotRouteVlessTLS(t, hotRoutePeer(t, name)), `"tag":"proxy"`, `"tag":"proxy","mux":{"enabled":true,"concurrency":8}`, 1)
+	}
+	inst, route := startHotRouteConfig(t, config("old"))
+	old := hotRouteDial(t, inst, "")
+	if got := hotRouteExchange(t, old, "before"); got != "old/1:before" {
+		t.Fatal(got)
+	}
+	id, err := route.prepare(0, config("candidate"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := route.probe(id, func(tag string) error {
+		probe := hotRouteDial(t, inst, tag)
+		hotRouteExchange(t, probe, "finish")
+		probe.Close()
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := route.commit(0, id); err != nil {
+		t.Fatal(err)
+	}
+	candidate := hotRouteDial(t, inst, "")
+	if got := hotRouteExchange(t, candidate, "before"); got != "candidate/2:before" {
+		t.Fatal(got)
+	}
+	if _, err := route.rollback(id, id); err == nil {
+		t.Fatal("wrong previous ID accepted")
+	}
+	revision, err := route.rollback(id, 0)
+	if err != nil || revision <= id {
+		t.Fatal("rollback failed: ", revision, err)
+	}
+	if got := hotRouteExchange(t, old, "after"); got != "old/1:after" {
+		t.Fatal(got)
+	}
+	if got := hotRouteExchange(t, candidate, "after"); got != "candidate/2:after" {
+		t.Fatal(got)
+	}
+	next := hotRouteDial(t, inst, "")
+	if got := hotRouteExchange(t, next, "finish"); got != "old/2:finish" {
+		t.Fatal(got)
+	}
+	next.Close()
+	if _, err := route.rollback(id, 0); err == nil {
+		t.Fatal("rollback replay accepted")
+	}
+	if _, err := route.prepare(revision, config("over-budget")); err == nil {
+		t.Fatal("third generation accepted during drain")
+	}
+	hotRouteExchange(t, candidate, "finish")
+	candidate.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	err = route.waitDrain(ctx)
+	cancel()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(route.manager.ListHandlers(context.Background())) != 1 {
+		t.Fatal("rolled-back candidate retained")
+	}
+	if _, err := route.prepare(0, config("stale")); err == nil {
+		t.Fatal("old version became valid again after rollback")
+	}
+	prepared, err := route.prepare(revision, config("retry"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := route.abort(prepared); err != nil {
+		t.Fatal(err)
+	}
+	hotRouteExchange(t, old, "finish")
+	route.Close()
+	if _, err := route.rollback(revision, id); err == nil {
+		t.Fatal("rollback after STOP accepted")
+	}
+}
