+// Characterization only: single-threaded rule publication is not proof of an
+// atomic production transaction, mux drain, Android TUN behavior or migration.
+func TestPinnedCoreKeepsOldTCPFlowWhileRoutingNewFlowsToCandidate(t *testing.T) {
+	oldPeer := hotRoutePeer(t, "old")
+	newPeer := hotRoutePeer(t, "candidate")
+	inst, err := core.StartInstance("json", []byte(hotRouteConfig("old", oldPeer)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { inst.Close() })
+	oldFlow := hotRouteDial(t, inst, "")
+	if got := hotRouteExchange(t, oldFlow, "one"); got != "old/1:one" {
+		t.Fatal(got)
+	}
+
+	config, err := coreserial.LoadJSONConfig(strings.NewReader(hotRouteConfig("candidate", newPeer)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	object, err := core.CreateObject(inst, config.Outbound[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	handler := object.(outbound.Handler)
+	manager := inst.GetFeature(outbound.ManagerType()).(outbound.Manager)
+	if err := manager.AddHandler(context.Background(), handler); err != nil {
+		t.Fatal(err)
+	}
+	probe := hotRouteDial(t, inst, "candidate")
+	if got := hotRouteExchange(t, probe, "probe"); got != "candidate/1:probe" {
+		t.Fatal(got)
+	}
+	probe.Close()
+	before := hotRouteDial(t, inst, "")
+	if got := hotRouteExchange(t, before, "before"); got != "old/2:before" {
+		t.Fatal(got)
+	}
+	before.Close()
+
+	router := inst.GetFeature(routing.RouterType()).(routing.Router)
+	if err := router.AddRule(hotRouteRules(t, hotRouteConfig("candidate", newPeer)), false); err != nil {
+		t.Fatal(err)
+	}
+	next := hotRouteDial(t, inst, "")
+	if got := hotRouteExchange(t, next, "new"); got != "candidate/2:new" {
+		t.Fatal(got)
+	}
+	if got := hotRouteExchange(t, oldFlow, "two"); got != "old/1:two" {
+		t.Fatal(got)
+	}
+	oldFlow.Close()
+	oldHandler := manager.GetHandler("old")
+	if err := manager.RemoveHandler(context.Background(), "old"); err != nil {
+		t.Fatal(err)
+	}
+	if err := oldHandler.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if got := hotRouteExchange(t, next, "three"); got != "candidate/2:three" {
+		t.Fatal(got)
+	}
+}
