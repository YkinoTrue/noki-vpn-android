+func TestHotRoutePrototypeStopDuringProbeRejectsLateSuccess(t *testing.T) {
+	_, route := startHotRoutePrototype(t)
+	id, err := route.prepare(0, hotRouteConfig("ignored", hotRoutePeer(t, "candidate")))
+	if err != nil {
+		t.Fatal(err)
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	defer close(release)
+	result := make(chan error, 1)
+	go func() {
+		result <- route.probe(id, func(string) error {
+			close(entered)
+			select {
+			case <-release:
+				return nil
+			case <-route.stopped:
+				return nil // Simulate a late successful completion after STOP.
+			case <-time.After(time.Second):
+				return fmt.Errorf("probe gate timeout")
+			}
+		})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("probe never started")
+	}
+	if err := route.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if err == nil {
+			t.Fatal("late probe accepted after STOP")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("STOP blocked by active probe")
+	}
+	if route.commit(0, id) == nil {
+		t.Fatal("stopped candidate published")
+	}
