+		t.Fatal("core retained after stop")
+	}
+	if err := controller.StopLoop(); err != nil {
+		t.Fatal(err)
+	}
+	if callbacks.starts != 1 || callbacks.stops != 1 {
+		t.Fatalf("callbacks starts=%d stops=%d", callbacks.starts, callbacks.stops)
+	}
