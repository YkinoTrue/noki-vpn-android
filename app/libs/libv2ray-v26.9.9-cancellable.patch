+// OutboundProbe owns exactly one candidate attempt. Cancel is safe before or
+// during Measure; it never touches the connected VPN controller or its probes.
+type OutboundProbe struct {
+	mu        sync.Mutex
+	used      bool
+	cancelled bool
+	cancel    context.CancelFunc
+}
+
+func NewOutboundProbe() *OutboundProbe { return &OutboundProbe{} }
+
+func (p *OutboundProbe) Cancel() {
+	p.mu.Lock()
+	p.cancelled = true
+	cancel := p.cancel
+	p.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+}
