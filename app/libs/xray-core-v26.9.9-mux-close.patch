+// Close is terminal: no new workers may be created after pool shutdown.
+func (p *IncrementalWorkerPicker) Close() error {
+	p.access.Lock()
+	defer p.access.Unlock()
+	p.closed = true
+	if p.cleanupTask != nil {
+		p.cleanupTask.Close()
+	}
+	for _, worker := range p.workers {
+		worker.Close()
+	}
+	p.workers = nil
+	return nil
 }
 
