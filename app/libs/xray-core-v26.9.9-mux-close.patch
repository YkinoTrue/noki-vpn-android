+func TestClientManagerCloseDisposesPool(t *testing.T) {
+	mockCtl := gomock.NewController(t)
+	defer mockCtl.Finish()
+	reader, writer := pipe.New(pipe.WithoutSizeLimit())
+	defer reader.Interrupt()
+	defer writer.Close()
+	worker, err := mux.NewClientWorker(transport.Link{Reader: reader, Writer: writer}, mux.ClientStrategy{})
+	common.Must(err)
+	defer worker.Close()
+	factory := mocks.NewMuxClientWorkerFactory(mockCtl)
+	factory.EXPECT().Create().Return(worker, nil).Times(1)
+	picker := &mux.IncrementalWorkerPicker{Factory: factory}
+	manager := &mux.ClientManager{Picker: picker}
+	if _, err := picker.PickAvailable(); err != nil {
+		t.Fatal(err)
+	}
+	common.Close(manager)
+	if !worker.Closed() {
+		t.Fatal("manager close left mux worker open")
+	}
+	if _, err := picker.PickAvailable(); err == nil {
+		t.Fatal("closed pool accepted new work")
+	}
+	common.Close(manager)
+	common.Close(&mux.ClientManager{Enabled: false})
+}
+
+func TestClientManagerCloseDuringPick(t *testing.T) {
+	for i := 0; i < 200; i++ {
+		mockCtl := gomock.NewController(t)
+		reader, writer := pipe.New(pipe.WithoutSizeLimit())
+		worker, err := mux.NewClientWorker(transport.Link{Reader: reader, Writer: writer}, mux.ClientStrategy{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		factory := mocks.NewMuxClientWorkerFactory(mockCtl)
+		var created atomic.Bool
+		factory.EXPECT().Create().DoAndReturn(func() (*mux.ClientWorker, error) {
+			created.Store(true)
+			return worker, nil
+		}).MaxTimes(1)
+		picker := &mux.IncrementalWorkerPicker{Factory: factory}
+		manager := &mux.ClientManager{Picker: picker}
+		start := make(chan struct{})
+		picked := make(chan struct{})
+		closed := make(chan struct{})
+		go func() { <-start; picker.PickAvailable(); close(picked) }()
+		go func() { <-start; common.Close(manager); close(closed) }()
+		close(start)
+		<-picked
+		<-closed
+		if created.Load() && !worker.Closed() {
+			t.Fatal("concurrent close leaked worker")
+		}
+		if _, err := picker.PickAvailable(); err == nil {
+			t.Fatal("closed pool accepted work")
+		}
+		worker.Close()
+		reader.Interrupt()
+		writer.Close()
+		mockCtl.Finish()
+	}
+}
